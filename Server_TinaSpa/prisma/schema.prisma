generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// role: ADMIN | MANAGER | STAFF | CUSTOMER (CHECK constraint "CK_User_role" trong DB)
model User {
  userAID      String    @id @default(dbgenerated("\"generateBusinessID\"('User'::text)")) @db.VarChar(20)
  userID       String    @unique(map: "UQ_User_userID") @default(dbgenerated("\"generateBusinessID\"('User'::text)")) @db.VarChar(14)
  phone        String    @unique(map: "UQ_User_phone") @db.VarChar(20)
  passwordHash String    @db.VarChar(255)
  fullName     String    @db.VarChar(100)
  avatar       String?
  address      String?   @db.VarChar(255)
  dateOfBirth  DateTime? @db.Date
  /// gender: MALE | FEMALE | OTHER (CHECK "CK_User_gender")
  gender       String?   @db.VarChar(10)
  role         String    @default("CUSTOMER") @db.VarChar(20)
  isActive     Boolean   @default(true)
  /// true khi nhân viên tạo tài khoản với mật khẩu mặc định (= số điện thoại); khách phải đổi mật khẩu
  mustChangePassword Boolean @default(false)
  /// Khu vực làm việc (MANAGER/STAFF) hoặc khu vực ghi nhận khách (CUSTOMER). ADMIN để trống.
  branchAID    String?   @db.VarChar(20)
  createdAt    DateTime  @default(now())
  createdByAID String?   @db.VarChar(20)
  updatedAt    DateTime  @default(now()) @updatedAt
  updatedByAID String?   @db.VarChar(20)
  note         String?

  branch                Branch?           @relation(fields: [branchAID], references: [branchAID], onDelete: Restrict, map: "FK_User_branchAID")
  refreshTokens         RefreshToken[]
  appointments          Appointment[]  @relation("AppointmentCustomer")
  confirmedAppointments Appointment[]  @relation("AppointmentConfirmedBy")
  servedAppointments    Appointment[]  @relation("AppointmentServedBy")
  customerServices      CustomerService[] @relation("CustomerServiceCustomer")
  authoredBlogs         Blog[]            @relation("BlogAuthor")

  @@index([role], map: "IX_User_role")
  @@index([branchAID], map: "IX_User_branchAID")
}

model RefreshToken {
  refreshTokenAID String    @id @default(dbgenerated("\"generateBusinessID\"('RefreshToken'::text)")) @db.VarChar(20)
  refreshTokenID  String    @unique(map: "UQ_RefreshToken_refreshTokenID") @default(dbgenerated("\"generateBusinessID\"('RefreshToken'::text)")) @db.VarChar(14)
  userAID         String    @db.VarChar(20)
  tokenJti        String    @unique(map: "UQ_RefreshToken_tokenJti") @db.VarChar(100)
  tokenHash       String    @unique(map: "UQ_RefreshToken_tokenHash") @db.VarChar(255)
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  createdByAID    String?   @db.VarChar(20)
  updatedAt       DateTime  @default(now()) @updatedAt
  updatedByAID    String?   @db.VarChar(20)
  note            String?

  user User @relation(fields: [userAID], references: [userAID], onDelete: Cascade, map: "FK_RefreshToken_userAID")

  @@index([userAID], map: "IX_RefreshToken_userAID")
  @@index([expiresAt], map: "IX_RefreshToken_expiresAt")
}

/// status: ACTIVE | INACTIVE (CHECK "CK_ServiceCategory_status")
model ServiceCategory {
  serviceCategoryAID String @id @default(dbgenerated("\"generateBusinessID\"('ServiceCategory'::text)")) @db.VarChar(20)
  serviceCategoryID  String @unique(map: "UQ_ServiceCategory_serviceCategoryID") @default(dbgenerated("\"generateBusinessID\"('ServiceCategory'::text)")) @db.VarChar(14)

  nameVietnamese String  @db.VarChar(255)
  nameEnglish    String? @db.VarChar(255)
  nameCambodia   String? @db.VarChar(255)

  slug                  String  @unique(map: "UQ_ServiceCategory_slug") @db.VarChar(50)
  descriptionVietnamese String?
  descriptionEnglish    String?
  descriptionCambodia   String?
  icon                  String? @db.VarChar(50)
  image                 String?
  imageAlt              String? @db.VarChar(255)
  isFeatured            Boolean @default(false)
  isBookable            Boolean @default(true)
  sortOrder             Int     @default(0)
  status                String  @default("ACTIVE") @db.VarChar(20)

  createdAt    DateTime  @default(now())
  createdByAID String?   @db.VarChar(20)
  updatedAt    DateTime  @default(now()) @updatedAt
  updatedByAID String?   @db.VarChar(20)
  deletedAt    DateTime?

  note String?

  services Service[]

  @@index([status, sortOrder], map: "IX_ServiceCategory_status_sortOrder")
}

/// status: ACTIVE | INACTIVE (CHECK "CK_Service_status")
model Service {
  serviceAID String @id @default(dbgenerated("\"generateBusinessID\"('Service'::text)")) @db.VarChar(20)
  serviceID  String @unique(map: "UQ_Service_serviceID") @default(dbgenerated("\"generateBusinessID\"('Service'::text)")) @db.VarChar(14)

  nameVietnamese String  @db.VarChar(255)
  nameEnglish    String? @db.VarChar(255)
  nameCambodia   String? @db.VarChar(255)

  serviceCategoryAID         String  @db.VarChar(20)
  slug                       String  @unique(map: "UQ_Service_slug") @db.VarChar(150)
  shortDescriptionVietnamese String? @db.VarChar(500)
  shortDescriptionEnglish    String? @db.VarChar(500)
  shortDescriptionCambodia   String? @db.VarChar(500)
  descriptionVietnamese      String?
  descriptionEnglish         String?
  descriptionCambodia        String?
  price                      Decimal @db.Decimal(12, 0)
  durationMinutes            Int?
  isBookable                 Boolean @default(true)
  sortOrder                  Int     @default(0)
  status                     String  @default("ACTIVE") @db.VarChar(20)

  createdAt    DateTime  @default(now())
  createdByAID String?   @db.VarChar(20)
  updatedAt    DateTime  @default(now()) @updatedAt
  updatedByAID String?   @db.VarChar(20)
  deletedAt    DateTime?

  note String?

  serviceCategory  ServiceCategory   @relation(fields: [serviceCategoryAID], references: [serviceCategoryAID], onDelete: Restrict, map: "FK_Service_serviceCategoryAID")
  customerServices CustomerService[]

  @@index([serviceCategoryAID, sortOrder], map: "IX_Service_serviceCategoryAID_sortOrder")
  @@index([status], map: "IX_Service_status")
}

/// Khu vực / cơ sở khách chọn khi đặt lịch.
/// status: ACTIVE | INACTIVE (CHECK "CK_Branch_status")
model Branch {
  branchAID String @id @default(dbgenerated("\"generateBusinessID\"('Branch'::text)")) @db.VarChar(20)
  branchID  String @unique(map: "UQ_Branch_branchID") @default(dbgenerated("\"generateBusinessID\"('Branch'::text)")) @db.VarChar(14)

  nameVietnamese String  @db.VarChar(255)
  nameEnglish    String? @db.VarChar(255)
  nameCambodia   String? @db.VarChar(255)

  slug              String  @unique(map: "UQ_Branch_slug") @db.VarChar(50)
  addressVietnamese String? @db.VarChar(255)
  addressEnglish    String? @db.VarChar(255)
  addressCambodia   String? @db.VarChar(255)
  hotline           String? @db.VarChar(100)
  /// HH:mm, giờ nhận khách đầu tiên / cuối cùng trong ngày
  openTime          String  @default("08:00") @db.VarChar(5)
  closeTime         String  @default("20:00") @db.VarChar(5)
  sortOrder         Int     @default(0)
  status            String  @default("ACTIVE") @db.VarChar(20)

  createdAt    DateTime  @default(now())
  createdByAID String?   @db.VarChar(20)
  updatedAt    DateTime  @default(now()) @updatedAt
  updatedByAID String?   @db.VarChar(20)
  deletedAt    DateTime?

  note String?

  appointments Appointment[]
  users        User[]

  @@index([status, sortOrder], map: "IX_Branch_status_sortOrder")
}

/// status: PENDING | CONFIRMED | ARRIVED | IN_SERVICE | COMPLETED | CANCELLED (CHECK "CK_Appointment_status")
model Appointment {
  appointmentAID String @id @default(dbgenerated("\"generateBusinessID\"('Appointment'::text)")) @db.VarChar(20)
  appointmentID  String @unique(map: "UQ_Appointment_appointmentID") @default(dbgenerated("\"generateBusinessID\"('Appointment'::text)")) @db.VarChar(14)

  nameVietnamese String? @db.VarChar(255)
  nameEnglish    String? @db.VarChar(255)
  nameCambodia   String? @db.VarChar(255)

  customerName     String    @db.VarChar(100)
  phoneNumber      String    @db.VarChar(20)
  customerAID      String?   @db.VarChar(20)
  branchAID        String    @db.VarChar(20)
  appointmentDate  DateTime  @db.Date
  /// HH:mm
  appointmentTime  String    @db.VarChar(5)
  customerNote     String?
  status           String    @default("PENDING") @db.VarChar(20)
  confirmedAt      DateTime?
  confirmedByAID   String?   @db.VarChar(20)
  checkedInAt      DateTime?
  serviceStartedAt DateTime?
  completedAt      DateTime?
  servedByAID      String?   @db.VarChar(20)
  /// Dặn dò / ghi nhận của nhân viên sau buổi chăm sóc
  serviceNote      String?

  createdAt    DateTime @default(now())
  createdByAID String?  @db.VarChar(20)
  updatedAt    DateTime @default(now()) @updatedAt
  updatedByAID String?  @db.VarChar(20)

  note String?

  branch      Branch @relation(fields: [branchAID], references: [branchAID], onDelete: Restrict, map: "FK_Appointment_branchAID")
  customer    User?  @relation("AppointmentCustomer", fields: [customerAID], references: [userAID], onDelete: SetNull, map: "FK_Appointment_customerAID")
  confirmedBy User?  @relation("AppointmentConfirmedBy", fields: [confirmedByAID], references: [userAID], onDelete: SetNull, map: "FK_Appointment_confirmedByAID")
  servedBy    User?  @relation("AppointmentServedBy", fields: [servedByAID], references: [userAID], onDelete: SetNull, map: "FK_Appointment_servedByAID")

  @@index([appointmentDate, branchAID], map: "IX_Appointment_appointmentDate_branchAID")
  @@index([phoneNumber], map: "IX_Appointment_phoneNumber")
  @@index([customerAID], map: "IX_Appointment_customerAID")
}

/// Dịch vụ khách đã sử dụng, do nhân viên ghi nhận (độc lập với Appointment).
/// name* và priceSnapshot là bản chụp tại thời điểm ghi nhận để sửa catalog không đổi lịch sử.
model CustomerService {
  customerServiceAID String @id @default(dbgenerated("\"generateBusinessID\"('CustomerService'::text)")) @db.VarChar(20)
  customerServiceID  String @unique(map: "UQ_CustomerService_customerServiceID") @default(dbgenerated("\"generateBusinessID\"('CustomerService'::text)")) @db.VarChar(14)

  nameVietnamese String  @db.VarChar(255)
  nameEnglish    String? @db.VarChar(255)
  nameCambodia   String? @db.VarChar(255)

  customerAID   String   @db.VarChar(20)
  serviceAID    String   @db.VarChar(20)
  priceSnapshot Decimal  @db.Decimal(12, 0)
  quantity      Int      @default(1)
  usedAt        DateTime @default(now())
  /// Ghi chú / dặn dò của nhân viên, khách xem được
  staffNote     String?

  createdAt    DateTime  @default(now())
  createdByAID String?   @db.VarChar(20)
  updatedAt    DateTime  @default(now()) @updatedAt
  updatedByAID String?   @db.VarChar(20)
  deletedAt    DateTime?

  note String?

  customer User    @relation("CustomerServiceCustomer", fields: [customerAID], references: [userAID], onDelete: Restrict, map: "FK_CustomerService_customerAID")
  service  Service @relation(fields: [serviceAID], references: [serviceAID], onDelete: Restrict, map: "FK_CustomerService_serviceAID")

  @@index([customerAID, usedAt], map: "IX_CustomerService_customerAID_usedAt")
  @@index([serviceAID], map: "IX_CustomerService_serviceAID")
}

/// Danh mục bài viết. Không có deletedAt: tắt hiển thị bằng isActive.
model BlogCategory {
  blogCategoryAID String @id @default(dbgenerated("\"generateBusinessID\"('BlogCategory'::text)")) @db.VarChar(20)
  blogCategoryID  String @unique(map: "UQ_BlogCategory_blogCategoryID") @default(dbgenerated("\"generateBusinessID\"('BlogCategory'::text)")) @db.VarChar(14)

  nameVietnamese String  @db.VarChar(255)
  nameEnglish    String? @db.VarChar(255)
  nameCambodia   String? @db.VarChar(255)

  slug         String  @unique(map: "UQ_BlogCategory_slug") @db.VarChar(255)
  description  String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  note String?

  blogs Blog[]

  @@index([isActive, displayOrder], map: "IX_BlogCategory_isActive_displayOrder")
}

/// status: DRAFT | PUBLISHED | HIDDEN (CHECK "CK_Blog_status"); PUBLISHED bắt buộc có publishedAt (CHECK "CK_Blog_publishedAt")
/// content là HTML đã được lọc bằng sanitizeBlogHtml trước khi lưu.
/// nameVietnamese / nameEnglish / nameCambodia là tiêu đề bài viết.
model Blog {
  blogAID String @id @default(dbgenerated("\"generateBusinessID\"('Blog'::text)")) @db.VarChar(20)
  blogID  String @unique(map: "UQ_Blog_blogID") @default(dbgenerated("\"generateBusinessID\"('Blog'::text)")) @db.VarChar(14)

  nameVietnamese String  @db.VarChar(255)
  nameEnglish    String? @db.VarChar(255)
  nameCambodia   String? @db.VarChar(255)

  blogCategoryAID String    @db.VarChar(20)
  slug            String    @unique(map: "UQ_Blog_slug") @db.VarChar(255)
  summary         String?
  content         String?
  thumbnailURL    String?
  authorAID       String?   @db.VarChar(20)
  status          String    @default("DRAFT") @db.VarChar(30)
  publishedAt     DateTime?
  isFeatured      Boolean   @default(false)
  viewCount       Int       @default(0)
  metaTitle       String?   @db.VarChar(255)
  metaDescription String?   @db.VarChar(320)

  createdAt    DateTime @default(now())
  createdByAID String?  @db.VarChar(20)
  updatedAt    DateTime @default(now()) @updatedAt
  updatedByAID String?  @db.VarChar(20)

  note String?

  blogCategory BlogCategory @relation(fields: [blogCategoryAID], references: [blogCategoryAID], onDelete: Restrict, map: "FK_Blog_blogCategoryAID")
  author       User?        @relation("BlogAuthor", fields: [authorAID], references: [userAID], onDelete: SetNull, map: "FK_Blog_authorAID")

  @@index([blogCategoryAID], map: "IX_Blog_blogCategoryAID")
  @@index([status, publishedAt(sort: Desc)], map: "IX_Blog_status_publishedAt")
}

model ProductCategory {
  productCategoryAID String @id @default(dbgenerated("\"generateBusinessID\"('ProductCategory'::text)")) @db.VarChar(20)
  productCategoryID  String @unique(map: "UQ_ProductCategory_productCategoryID") @default(dbgenerated("\"generateBusinessID\"('ProductCategory'::text)")) @db.VarChar(14)

  nameVietnamese String  @db.VarChar(255)
  nameEnglish    String? @db.VarChar(255)
  nameCambodia   String? @db.VarChar(255)

  slug         String  @unique(map: "UQ_ProductCategory_slug") @db.VarChar(150)
  description  String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt    DateTime @default(now())
  createdByAID String?  @db.VarChar(20)
  updatedAt    DateTime @default(now()) @updatedAt
  updatedByAID String?  @db.VarChar(20)

  note String?

  products Product[]

  @@index([isActive, displayOrder], map: "IX_ProductCategory_isActive_displayOrder")
}

model Product {
  productAID String @id @default(dbgenerated("\"generateBusinessID\"('Product'::text)")) @db.VarChar(20)
  productID  String @unique(map: "UQ_Product_productID") @default(dbgenerated("\"generateBusinessID\"('Product'::text)")) @db.VarChar(14)

  nameVietnamese String  @db.VarChar(255)
  nameEnglish    String? @db.VarChar(255)
  nameCambodia   String? @db.VarChar(255)

  slug                  String   @unique(map: "UQ_Product_slug") @db.VarChar(150)
  subtitleVietnamese    String?  @db.VarChar(255)
  subtitleEnglish       String?  @db.VarChar(255)
  subtitleCambodia      String?  @db.VarChar(255)
  descriptionVietnamese String?
  descriptionEnglish    String?
  descriptionCambodia   String?
  productCategoryAID    String   @db.VarChar(20)
  price                 Decimal  @db.Decimal(12, 0)
  compareAtPrice        Decimal? @db.Decimal(12, 0)
  image                 String?
  imageAlt              String?  @db.VarChar(255)
  badge                 String?  @db.VarChar(100)
  status                String   @default("ACTIVE") @db.VarChar(30)

  createdAt    DateTime  @default(now())
  createdByAID String?   @db.VarChar(20)
  updatedAt    DateTime  @default(now()) @updatedAt
  updatedByAID String?   @db.VarChar(20)
  deletedAt    DateTime?

  note String?

  productCategory ProductCategory @relation(fields: [productCategoryAID], references: [productCategoryAID], onDelete: Restrict, map: "FK_Product_productCategoryAID")
  details         ProductDetail[]
  variants        ProductVariant[]

  @@index([productCategoryAID, status], map: "IX_Product_productCategoryAID_status")
}

/// price / compareAtPrice on Product are the "from" price: kept in sync with the cheapest active variant by the API.
model ProductVariant {
  productVariantAID String @id @default(dbgenerated("\"generateBusinessID\"('ProductVariant'::text)")) @db.VarChar(20)
  productVariantID  String @unique(map: "UQ_ProductVariant_productVariantID") @default(dbgenerated("\"generateBusinessID\"('ProductVariant'::text)")) @db.VarChar(14)

  nameVietnamese String  @db.VarChar(255)
  nameEnglish    String? @db.VarChar(255)
  nameCambodia   String? @db.VarChar(255)

  productAID     String   @db.VarChar(20)
  sku            String?  @unique(map: "UQ_ProductVariant_sku") @db.VarChar(50)
  price          Decimal  @db.Decimal(12, 0)
  compareAtPrice Decimal? @db.Decimal(12, 0)
  status         String   @default("ACTIVE") @db.VarChar(30)
  sortOrder      Int      @default(0)

  createdAt    DateTime @default(now())
  createdByAID String?  @db.VarChar(20)
  updatedAt    DateTime @default(now()) @updatedAt
  updatedByAID String?  @db.VarChar(20)

  note String?

  images  ProductVariantImage[]
  product Product @relation(fields: [productAID], references: [productAID], onDelete: Cascade, map: "FK_ProductVariant_productAID")

  @@index([productAID, sortOrder], map: "IX_ProductVariant_productAID_sortOrder")
}

/// Gallery of one variant. nameVietnamese/nameEnglish/nameCambodia hold the alt text.
model ProductVariantImage {
  productVariantImageAID String @id @default(dbgenerated("\"generateBusinessID\"('ProductVariantImage'::text)")) @db.VarChar(20)
  productVariantImageID  String @unique(map: "UQ_ProductVariantImage_productVariantImageID") @default(dbgenerated("\"generateBusinessID\"('ProductVariantImage'::text)")) @db.VarChar(14)

  nameVietnamese String  @db.VarChar(255)
  nameEnglish    String? @db.VarChar(255)
  nameCambodia   String? @db.VarChar(255)

  productVariantAID String @db.VarChar(20)
  image             String
  sortOrder         Int    @default(0)

  createdAt    DateTime @default(now())
  createdByAID String?  @db.VarChar(20)
  updatedAt    DateTime @default(now()) @updatedAt
  updatedByAID String?  @db.VarChar(20)

  note String?

  productVariant ProductVariant @relation(fields: [productVariantAID], references: [productVariantAID], onDelete: Cascade, map: "FK_ProductVariantImage_productVariantAID")

  @@index([productVariantAID, sortOrder], map: "IX_ProductVariantImage_productVariantAID_sortOrder")
}

model ProductDetail {
  productDetailAID String @id @default(dbgenerated("\"generateBusinessID\"('ProductDetail'::text)")) @db.VarChar(20)
  productDetailID  String @unique(map: "UQ_ProductDetail_productDetailID") @default(dbgenerated("\"generateBusinessID\"('ProductDetail'::text)")) @db.VarChar(14)

  nameVietnamese String  @db.VarChar(255)
  nameEnglish    String? @db.VarChar(255)
  nameCambodia   String? @db.VarChar(255)

  productAID        String  @db.VarChar(20)
  detailType        String  @db.VarChar(30)
  contentVietnamese String?
  contentEnglish    String?
  contentCambodia   String?
  icon              String? @db.VarChar(100)
  image             String?
  imageAlt          String? @db.VarChar(255)
  sortOrder         Int     @default(0)

  createdAt    DateTime @default(now())
  createdByAID String?  @db.VarChar(20)
  updatedAt    DateTime @default(now()) @updatedAt
  updatedByAID String?  @db.VarChar(20)

  note String?

  product Product @relation(fields: [productAID], references: [productAID], onDelete: Cascade, map: "FK_ProductDetail_productAID")

  @@index([productAID, detailType, sortOrder], map: "IX_ProductDetail_productAID_detailType")
}

model BusinessIdCounter {
  tableName   String   @db.VarChar(100)
  counterDate DateTime @db.Date
  lastValue   Int

  @@id([tableName, counterDate], map: "PK_BusinessIdCounter")
}
