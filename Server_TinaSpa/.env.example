PORT=3000
CORS_ORIGIN=http://localhost:5057

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tinaspa?schema=public

JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Cloudflare R2 (S3-compatible). Backend only — never expose to the frontend.
R2_ACCOUNT_ID=a312f6b6bb582fb44a660bc6eb8e5dcb
R2_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
R2_BUCKET_NAME=tinaspa-images
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://YOUR_PUBLIC_R2_DOMAIN.r2.dev
R2_REGION=auto

# Optional (defaults shown)
R2_PRESIGNED_EXPIRES_IN=900
STORAGE_MAX_FILE_SIZE_MB=10
